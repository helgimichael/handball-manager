{
  "name": "@handball-manager/game",
  "version": "0.0.0",
  "private": true,
  "description": "Handball Manager — the actual game application. Distinct from apps/field-smoke-test and apps/match-demo, which remain engine verification/debug hosts.",
  "scripts": {
    "predev": "node scripts/generate-real-world-bundle.mjs",
    "prebuild": "node scripts/generate-real-world-bundle.mjs",
    "pretest": "node scripts/generate-real-world-bundle.mjs",
    "pretypecheck": "node scripts/generate-real-world-bundle.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-game-tests.mjs",
    "test:all:portable": "node scripts/run-game-tests.mjs",
    "test:season:management": "node --import tsx scripts/management-season-smoke.ts",
    "test:sim": "node --import tsx --test lib/career/simulationHarness.sim.test.ts lib/career/youthIntakeWorldScope.sim.test.ts",
    "test:management": "node --import tsx --test lib/career/management.test.ts lib/career/navigation.test.ts lib/career/inboxActions.test.ts lib/career/inboxFilters.test.ts lib/career/recruitment.test.ts lib/career/scouting.test.ts lib/career/transferCareerIntegration.test.ts lib/career/contractCareerIntegration.test.ts lib/save/saveRepository.test.ts",
    "test:e2e:management": "playwright test e2e/management.spec.ts e2e/product.spec.ts --workers=1",
    "test:e2e:game": "playwright test e2e/game-presentation.spec.ts e2e/management.spec.ts e2e/product.spec.ts --workers=1",
    "test:experience": "node --import tsx --test components/game/progressionPresentation.test.ts",
    "test:e2e:experience": "playwright test e2e/game-experience-v11.spec.ts e2e/game-presentation.spec.ts e2e/management.spec.ts e2e/product.spec.ts --workers=1",
    "test:product": "node --import tsx --test lib/career/productionMatch.test.ts lib/save/saveRepository.test.ts",
    "test:e2e": "playwright test e2e/product.spec.ts --workers=1",
    "test:season": "node --import tsx scripts/playable-season-smoke.ts",
    "test:benchmarks": "node --import tsx --test lib/matchBenchmarks/benchmarks.test.ts",
    "benchmark:fast": "node --import tsx scripts/match-benchmarks.ts --mode fast",
    "benchmark:calibration": "node --import tsx scripts/match-benchmarks.ts --mode calibration",
    "empirical:rebuild": "node --import tsx scripts/rebuild-empirical-benchmarks.ts",
    "empirical:report": "node scripts/report-empirical-data.mjs",
    "empirical:compare": "node --import tsx scripts/compare-empirical-benchmarks.ts",
    "empirical:verify": "node scripts/verify-empirical-evidence.mjs",
    "empirical:calibration:report": "node --import tsx scripts/report-empirical-calibration.ts",
    "empirical:calibration:checks": "node --import tsx scripts/check-empirical-calibration.ts",
    "motion:quality:report": "node --import tsx scripts/report-motion-quality.ts",
    "test:empirical": "node --import tsx --test lib/matchBenchmarks/benchmarks.test.ts lib/matchBenchmarks/empirical.test.ts",
    "test:match-center": "node --import ./scripts/register-asset-loader.cjs --import tsx --test lib/matchCenter/model.test.ts lib/matchCenter/presentation.test.ts lib/matchCenter/workspace.test.ts",
    "build:worker": "node scripts/build-cloudflare-worker.mjs"
  },
  "dependencies": {
    "@handball-manager/game-simulation": "*",
    "@handball-manager/handball-engine": "*",
    "@handball-manager/match-contract": "*",
    "@handball-manager/match-integration": "*",
    "@handball-manager/match-renderer": "*",
    "@handball-manager/tactical-domain": "*",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
