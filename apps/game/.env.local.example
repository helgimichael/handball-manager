# Copy this file to .env.local (gitignored, never committed) to enable
# the development-only data editor (HM-DATA-EDITOR-0.1).
#
# The editor is refused entirely -- navigation hidden, /editor/* routes
# 404, /api/editor/* routes return 403 -- unless BOTH of the following
# are true:
#   1. HM_EDITOR_ENABLED=true
#   2. the app is NOT running with NODE_ENV=production (`next dev`, or
#      `next build`/`next start` invoked with NODE_ENV explicitly unset
#      from production, satisfy this)
#
# See apps/game/lib/editor/env.ts for the exact guard.

HM_EDITOR_ENABLED=true
