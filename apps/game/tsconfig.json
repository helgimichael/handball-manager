{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-management/types/**/*.ts",
    ".next-management/dev/types/**/*.ts",
    ".next-management-build/types/**/*.ts",
    ".next-management-build/dev/types/**/*.ts",
    ".next-management-final/types/**/*.ts",
    ".next-management-final/dev/types/**/*.ts",
    ".next-game-experience/types/**/*.ts",
    ".next-game-experience/dev/types/**/*.ts",
    ".next-game-production/types/**/*.ts",
    ".next-game-production/dev/types/**/*.ts",
    ".next-game-final/types/**/*.ts",
    ".next-game-final/dev/types/**/*.ts",
    ".next-game-v11/types/**/*.ts",
    ".next-game-v11/dev/types/**/*.ts",
    ".next-game-realism-v2/types/**/*.ts",
    ".next-game-realism-v2/dev/types/**/*.ts",
    ".next-game-realism-v21/types/**/*.ts",
    ".next-game-realism-v21/dev/types/**/*.ts",
    ".next-game-motion-v1/types/**/*.ts",
    ".next-game-motion-v1/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
